# Copy this file to bin/.env and fill in your values.
# bin/.env is gitignored (contains secrets). Never commit it.
#
#   cp bin/.env.example bin/.env

# Your GCP project ID (must be globally unique).
PROJECT_ID=colab-app

# GCP region (Mumbai, India — closest to reviewers).
REGION=asia-south1

# Cloud SQL user password (choose a strong one).
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_-hex_32
